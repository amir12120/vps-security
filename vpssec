# Update
# ============================================================

cmd_update() {
    need_root
    ui_title "Update vps-security"
    info "Fetching the latest version from GitHub..."
    if [ ! -d "$TARGET_DIR/.git" ]; then
        err "vps-security is not installed at $TARGET_DIR."
        info "Install it first:  bash <(curl -fsSL $REPO_RAW/install.sh)"
        return 1
    fi
    local before
    before="$(git -C "$TARGET_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    if ! git -C "$TARGET_DIR" fetch origin main 2>&1 | sed 's/^/    /'; then
        err "Could not reach GitHub (check the server's internet access)."
        return 1
    fi
    local after
    after="$(git -C "$TARGET_DIR" rev-parse --short origin/main 2>/dev/null || echo unknown)"
    if [ "$before" = "$after" ]; then
        ok "Already up to date ($before)."
        return 0
    fi
    git -C "$TARGET_DIR" reset --hard origin/main >/dev/null 2>&1
    chmod +x "$TARGET_DIR/vpssec" "$TARGET_DIR"/lib/*.sh "$TARGET_DIR"/test/*.sh 2>/dev/null || true
    ln -sf "$TARGET_DIR/vpssec" /usr/local/bin/vpssec
    ok "Updated: $before → $after."
    if [ -x "$TARGET_DIR/lib/monitor.sh" ]; then
        $SYSTEMCTL restart vps-security-guard.service 2>/dev/null || true
        $SYSTEMCTL restart vps-security-monitor.timer 2>/dev/null || true
        ok "Services restarted with the new code."
    fi
}

