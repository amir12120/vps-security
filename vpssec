#!/usr/bin/env bash
# ============================================================
# vpssec — beautiful interactive security CLI for Ubuntu servers
#
# Usage: sudo vpssec            (TUI menu)
#        sudo vpssec <command>  (direct)
#        sudo vpssec install    (guided setup — ends by opening the TUI menu)
#
# Commands:
#   install      First-time setup (update, SSH port, firewall, monitor)
#   status       Show firewall, SSH and monitor status
#   ports        Add / remove allowed ports
#   port         Change the SSH port
#   scan         Run a rogue-port scan right now
#   blocked      View blocked ports
#   unblock      Release a blocked port
#   update       Update vps-security from GitHub
#   maint        RAM cache & log cleanup (run / status)
#   mirror       Best Iranian mirror & DNS (best / test / reset / status)
#   shield       Bot & Scanner Shield (enable / disable / status)
#   geo          Country filter (add / remove / list / names / enable / disable / bypass / refresh)
#   logs         Show monitor log
#   uninstall    Remove vps-security completely
#   help         Show this help
#
# The TUI needs arrow keys; over a plain pipe it falls back to a
# numbered menu automatically.
# ============================================================

set -u

# ------------------------------------------------------------
# Locate our own directory. The bootstrap installer links
#   /usr/local/bin/vpssec -> <repo>/vpssec
# and bash reports ${BASH_SOURCE[0]} as that *symlink* path — not the
# target. Without resolving it, lib/common.sh would be sourced from
# /usr/local/bin, leaving every helper and colour unset, and the CLI
# would die with "unbound variable" before ever drawing the menu.
# ------------------------------------------------------------
resolve_script_dir() {
    local src="$1" target hops=0
    while [ -L "$src" ] && [ "$hops" -lt 20 ]; do
        target="$(readlink "$src" 2>/dev/null || true)"
        [ -z "$target" ] && break
        case "$target" in
            /*) src="$target" ;;
            *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
        esac
        hops=$((hops + 1))
    done
    (cd "$(dirname "$src")" && pwd)
}
SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"

# Fallback: a symlink or copied CLI whose lib/ did not travel with it.
if [ ! -f "$SCRIPT_DIR/lib/common.sh" ] && [ -f /opt/vps-security/lib/common.sh ]; then
    SCRIPT_DIR="/opt/vps-security"
fi
if [ ! -f "$SCRIPT_DIR/lib/common.sh" ]; then
    echo "[✗] vps-security libraries not found in $SCRIPT_DIR/lib" >&2
    echo "    Reinstall with:" >&2
    echo "      bash <(curl -fsSL https://raw.githubusercontent.com/amir12120/vps-security/main/install.sh)" >&2
    exit 1
fi
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

VERSION="1.3.4"
INSTALL_DIR="${VPSSEC_INSTALL_DIR:-/usr/local/share/vps-security}"
REPO_RAW="${VPSSEC_REPO_RAW:-https://raw.githubusercontent.com/amir12120/vps-security/main}"
REPO_URL="${VPSSEC_REPO_URL:-https://github.com/amir12120/vps-security.git}"

# Sandbox-overridable system paths (test suite redirects these)
SSH_CFG="${VPSSEC_SSHD_CONFIG:-/etc/ssh/sshd_config}"
SYSTEMCTL="${VPSSEC_SYSTEMCTL:-systemctl}"
TARGET_DIR="${VPSSEC_TARGET_DIR:-/opt/vps-security}"

svc_restart_ssh() {
    $SYSTEMCTL restart sshd 2>/dev/null || $SYSTEMCTL restart ssh 2>/dev/null || service ssh restart
}

# ============================================================
# Tiny TUI helpers (pure bash + ANSI)
# ============================================================

ui_header() {
    echo -e "${CYAN}${BOLD}"
    cat <<'BANNER'
    __    __    ____    ____  ____   ______  .______        _______.
   /  \  /  \  / __ \  \   \/   /  /      | |   _  \      /       |
  /  ^  ^  \ / / _\ \  \  \  /   |  ,----' |  |_)  |    |   (----`
 /  /_\\  \ (  (_)  )  |  |  |   |  |      |      /      \   \    
/  _____,  \ \____/   _|  |__|  _|  |____ _|  |\  \----.)   |    
\_/     \__/          |__| (_____|________)_| _| `._____|____/     
BANNER
    echo -e "${RESET}"
    echo -e "  ${BOLD}vps-security${RESET} ${DIM}v${VERSION}${RESET} ${DIM}— server hardening toolkit${RESET}"
    echo
}

ui_line() { echo -e "  ${DIM}─────────────────────────────────────────────────────${RESET}"; }

ui_title() {
    clear 2>/dev/null || true
    ui_header
    echo -e "  ${BOLD}${CYAN}$1${RESET}"
    ui_line
    echo
}

# Draw a menu: ui_menu "Title" item1 item2 ... ; returns chosen index in MENU_IDX
# Arrow keys + Enter, or number keys + Enter. Q = quit (idx 0).
ui_menu() {
    local title="$1"; shift
    local items=("$@")
    local sel=0 n=${#items[@]}

    # No TTY -> simple numbered fallback
    if [ ! -t 0 ]; then
        ui_title "$title"
        local i
        for i in "${!items[@]}"; do
            printf "  %2d) %s\n" $((i + 1)) "${items[$i]}"
        done
        printf "   0) Back / Exit\n"
        prompt "Select: "
        read -r MENU_IDX
        case "$MENU_IDX" in
            ''|*[!0-9]*) MENU_IDX=0 ;;
        esac
        [ "$MENU_IDX" -gt "$n" ] && MENU_IDX=0
        return 0
    fi

    # Arrow-key mode
    ui_title "$title"
    while :; do
        local i row=$((2))
        printf "\033[H" 2>/dev/null || true
        for i in "${!items[@]}"; do
            local marker="${DIM} ${RESET}" color="" line
            line="${items[$i]}"
            if [ "$i" -eq "$sel" ]; then
                printf "  ${GREEN}❯ ${BOLD}%s${RESET}\n" "$line"
            else
                printf "    ${DIM}%s${RESET}\n" "$line"
            fi
        done
        printf "\n  ${DIM}↑/↓ move · Enter select · q back${RESET}\n"
        printf "\033[%dA" "$((n + 2))" 2>/dev/null || true
        IFS= read -rsn1 key
        case "$key" in
            $'\x1b')   # escape sequence
                read -rsn2 -t 0.1 rest
                case "$rest" in
                    '[A'|'OA') ((sel > 0)) && sel=$((sel - 1)) ;;
                    '[B'|'OB') ((sel < n - 1)) && sel=$((sel + 1)) ;;
                esac
                ;;
            'k') ((sel > 0)) && sel=$((sel - 1)) ;;
            'j') ((sel < n - 1)) && sel=$((sel + 1)) ;;
            '') [ "$n" -gt 0 ] && { MENU_IDX=$((sel + 1)); return 0; } ;;
            'q') MENU_IDX=0; return 0 ;;
            [1-9])
                if [ "$key" -le "$n" ]; then MENU_IDX="$key"; return 0; fi
                ;;
        esac
    done
}

ui_press_any_key() {
    echo
    prompt "Press Enter to continue..."
    read -r _
}

# ============================================================
# Shared helpers
# ============================================================

prompt() { printf "%b" "${BOLD}$*${RESET}" >&2; }

read_port() {
    local label="$1" default="${2:-}" val
    while :; do
        if [ -n "$default" ]; then
            prompt "$label [$default]: "
        else
            prompt "$label: "
        fi
        read -r val
        [ -z "$val" ] && val="$default"
        if is_valid_port "$val"; then
            printf '%s\n' "$val"
            return 0
        fi
        warn "Enter a valid port (1-65535)."
    done
}

read_confirm() {
    local q="$1" def="${2:-y}" a
    prompt "$q"
    read -r a
    [ -z "$a" ] && a="$def"
    case "$a" in
        [Yy]|[Yy][Ee][Ss]) return 0 ;;
        *) return 1 ;;
    esac
}

ssh_port_in_config() {
    grep -E '^\s*Port\s+' "$SSH_CFG" 2>/dev/null | tail -1 | awk '{print $2}'
}

set_ssh_port() {
    local new="$1"
    if grep -qE '^\s*Port\s+' "$SSH_CFG"; then
        sed -i -E "s/^[#[:space:]]*Port[[:space:]].*/Port $new/" "$SSH_CFG"
    else
        printf '\nPort %s\n' "$new" >> "$SSH_CFG"
    fi
}

port_count() { list_ports_raw | wc -l | tr -d ' '; }

list_ports_raw() {
    [ -f "$ALLOWED_PORTS_CONF" ] || return 0
    while IFS= read -r p || [ -n "$p" ]; do
        p="${p%%#*}"; p="$(printf '%s' "$p" | tr -d '[:space:]')"
        [ -z "$p" ] && continue
        printf '%s\n' "$p"
    done < "$ALLOWED_PORTS_CONF"
}

blocked_count() {
    [ -f "$BLOCK_LIST_FILE" ] && grep -cE '^[0-9]+\|[0-9]+$' "$BLOCK_LIST_FILE" || true
}

ufw_active() {
    command -v ufw >/dev/null 2>&1 && [ "$(ufw status 2>/dev/null | head -1 | awk '{print $2}')" = "active" ]
}

monitor_installed() {
    [ -f "$VPSSEC_SYSTEMD_DIR/vps-security-monitor.timer" ]
}

# ============================================================
# Install flow (step 1-4 guided setup)
# ============================================================

# Entry point for the guided setup. When it is invoked directly —
# `vpssec install`, or right after the bootstrap installer — drop the
# user straight into the TUI menu once the steps are done.
cmd_install() {
    _install_guided "$@"
    maybe_enter_menu
}

# Open the TUI after setup, unless we are already inside it or nobody has a
# terminal to draw on (piped/CI runs must not block waiting for a keypress).
maybe_enter_menu() {
    [ "${VPSSEC_MENU_ACTIVE:-0}" = "1" ] && return 0  # already in the menu
    [ "${VPSSEC_NO_MENU:-0}" = "1" ] && return 0      # caller opted out
    [ -t 0 ] && [ -t 1 ] || return 0                   # no TTY -> stay silent
    echo
    info "Setup finished — opening the vpssec menu (q = back, Exit = quit)."
    sleep 1
    show_menu
}

_install_guided() {
    need_root
    require_debian_like
    ensure_dirs

    echo
    echo "=============================================="
    echo "  vps-security $VERSION — guided setup"
    echo "=============================================="
    echo
    info "This setup will:"
    echo "  1. Run 'apt update && apt upgrade -y'"
    echo "  2. Change the SSH port to a new one you choose"
    echo "  3. Install ufw, open the ports you approve, enable the firewall"
    echo "  4. Install a monitor that auto-blocks rogue ports for 1 hour"
    echo

    # ------------------------------------------------
    # Step 1 — system update
    # ------------------------------------------------
    if read_confirm "Step 1/4 — run 'apt update && apt upgrade -y' now? [Y/n] "; then
        info "Updating package lists and upgrading packages (this can take a while)..."
        apt-get update -y
        DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
        ok "System is up to date."
    else
        warn "Skipping system update."
    fi
    echo

    # ------------------------------------------------
    # Step 2 — SSH port
    # ------------------------------------------------
    local current_port new_port
    current_port="$(ssh_port_in_config)"
    [ -z "$current_port" ] && current_port="22"

    echo "Step 2/4 — SSH port"
    info "Current SSH port: $current_port"
    new_port="$(read_port "New SSH port" "$current_port")"

    if [ "$new_port" != "$current_port" ]; then
        # Old port must stay reachable until the new one is confirmed
        if command -v ufw >/dev/null 2>&1; then
            ufw allow "$current_port"/tcp >/dev/null 2>&1 || true
        fi

        info "Backing up and updating $SSH_CFG..."
        cp "$SSH_CFG" "$SSH_CFG.bak.$(date +%s)"
        set_ssh_port "$new_port"

        info "Validating and restarting sshd..."
        if sshd -t 2>/dev/null; then
            svc_restart_ssh
            sleep 1
            if ss -tlnp 2>/dev/null | grep -q ":$new_port "; then
                ok "SSH is now listening on port $new_port."
                ufw allow "$new_port"/tcp >/dev/null 2>&1 || true
                ufw allow "$new_port"/udp >/dev/null 2>&1 || true
                # Register the new SSH port immediately (before Step 3) so the
                # allow-list can never miss it, even if setup stops here.
                ensure_dirs
                touch "$ALLOWED_PORTS_CONF"
                grep -qx "$new_port" "$ALLOWED_PORTS_CONF" 2>/dev/null || echo "$new_port" >> "$ALLOWED_PORTS_CONF"
                if read_confirm "Close old port $current_port now? [Y/n] "; then
                    ufw delete allow "$current_port"/tcp >/dev/null 2>&1 || true
                    ok "Old port $current_port closed."
                else
                    info "Old port left open — close it later from Ports menu."
                fi
                current_port="$new_port"
            else
                err "SSH did not come up on the new port — rolling back."
                cp "$(ls -t "$SSH_CFG".bak.* 2>/dev/null | head -1)" "$SSH_CFG"
                svc_restart_ssh
                die "SSH port change failed; original config restored."
            fi
        else
            cp "$(ls -t "$SSH_CFG".bak.* 2>/dev/null | head -1)" "$SSH_CFG"
            die "sshd_config validation failed — no change was made."
        fi
    else
        ok "SSH port unchanged ($current_port)."
    fi
    echo

    # ------------------------------------------------
    # Step 3 — firewall
    # ------------------------------------------------
    echo "Step 3/4 — Firewall (ufw)"
    ensure_dirs
    touch "$ALLOWED_PORTS_CONF"
    if [ -s "$ALLOWED_PORTS_CONF" ]; then
        info "Existing allowed ports: $(tr '\n' ' ' < "$ALLOWED_PORTS_CONF")"
    fi

    info "Enter the ports to keep open, one per line. Empty line = finish."
    info "SSH port $current_port is added automatically."
    grep -qx "$current_port" "$ALLOWED_PORTS_CONF" || echo "$current_port" >> "$ALLOWED_PORTS_CONF"

    local p
    while :; do
        prompt "  Port (blank to finish): "
        read -r p
        [ -z "$p" ] && break
        if ! is_valid_port "$p"; then
            warn "Invalid port."
            continue
        fi
        if grep -qx "$p" "$ALLOWED_PORTS_CONF" 2>/dev/null; then
            info "  $p is already in the list."
            continue
        fi
        echo "$p" >> "$ALLOWED_PORTS_CONF"
        ok "  $p added."
    done

    # SAFETY: if the user added NO ports of their own (list = just SSH),
    # do not enable a restrictive firewall at all — leave the system open
    # on every port and skip the monitor (nothing to protect).
    local user_port_count=0
    while IFS= read -r p || [ -n "$p" ]; do
        p="${p%%#*}"; p="$(printf '%s' "$p" | tr -d '[:space:]')"
        [ -z "$p" ] && continue
        [ "$p" = "$current_port" ] || user_port_count=$((user_port_count + 1))
    done < "$ALLOWED_PORTS_CONF"

    if [ "$user_port_count" -eq 0 ]; then
        warn "No extra ports were specified — the firewall will NOT be enabled."
        info "The server stays fully accessible on every port."
        info "Configure ports later via the Ports menu, or re-run install."
        rm -f "$ALLOWED_PORTS_CONF"
        echo
        warn "Step 4/4 — Rogue-port monitor skipped (no allow-list to protect)."
        info "System update and SSH port changes are already applied."
        info "Menu: sudo vpssec"
        return 0
    fi

    info "Installing ufw..."
    apt-get install -y ufw >/dev/null 2>&1 || true
    ufw --force reset >/dev/null 2>&1 || true
    while IFS= read -r p || [ -n "$p" ]; do
        p="${p%%#*}"; p="$(printf '%s' "$p" | tr -d '[:space:]')"
        [ -z "$p" ] && continue
        ufw allow "$p"/tcp >/dev/null
        ufw allow "$p"/udp >/dev/null
    done < "$ALLOWED_PORTS_CONF"
    ufw --force enable
    ufw status verbose
    ok "Firewall enabled — only the approved ports are open."
    echo

    # ------------------------------------------------
    # Step 4 — rogue-port monitor
    # ------------------------------------------------
    echo "Step 4/4 — Rogue-port monitor"
    info "Every 30 minutes the server is scanned for connections on ports"
    info "outside your allow-list. A rogue port carrying traffic is blocked"
    info "via ufw for one hour, then automatically released."
    local guard_port
    guard_port="$(read_port "Local API port for the monitor (for the future dashboard)" "18080")"
    cat > "$MONITOR_CONF" <<EOF
MONITOR_SELF_PORT=$current_port
MONITOR_GUARD_PORT=$guard_port
EOF
    chmod 600 "$MONITOR_CONF"

    if read_confirm "Open the monitor API port $guard_port on the firewall? [y/N] " "n"; then
        ufw allow "$guard_port"/tcp >/dev/null
        ufw allow "$guard_port"/udp >/dev/null
        ok "Monitor API port $guard_port open."
    else
        info "Monitor API stays local-only. Add it later from the Ports menu."
    fi
    if read_confirm "Run a first monitor scan now? [Y/n] "; then
        "$SCRIPT_DIR/lib/monitor.sh" --scan || true
    fi

    install_systemd "$current_port" "$guard_port"

    # ------------------------------------------------
    # Step 5 — optional shields
    # ------------------------------------------------
    echo
    echo "Step 5/5 — Bot shield & GeoIP filter (optional)"
    if read_confirm "Enable the Bot & Scanner Shield (rate limits + auto-ban)? [Y/n] "; then
        "$SCRIPT_DIR/lib/botshield.sh" --enable || true
    else
        info "You can enable it later from the menu (Bot & Scanner Shield)."
    fi
    if read_confirm "Restrict server access by country (GeoIP filter)? [y/N] " "n"; then
        local cc_in
        prompt "  Country codes, comma-separated (e.g. IR,DE): "
        read -r cc_in
        if [ -n "$cc_in" ]; then
            "$SCRIPT_DIR/lib/geoip.sh" --add "$cc_in" || true
            "$SCRIPT_DIR/lib/geoip.sh" --enable || true
        fi
    else
        info "You can set it up later from the menu (GeoIP country filter)."
    fi

    echo
    echo "=============================================="
    ok "vps-security setup complete!"
    echo "=============================================="
    echo
    info "SSH       : port $current_port"
    info "Firewall  : ufw active, allowed ports: $(tr '\n' ' ' < "$ALLOWED_PORTS_CONF" | tr -s ' ')"
    info "Monitor   : every 30 min, 1-hour auto-block, guard port $guard_port"
    echo
    info "CLI       : sudo vpssec"
    info "Status    : sudo vpssec status"
    echo
}

install_systemd() {
    local ssh_port="$1" guard_port="$2"
    info "Installing systemd service and timer..."
    mkdir -p "$INSTALL_DIR"
    cp -r "$SCRIPT_DIR/lib" "$INSTALL_DIR/"
    chmod 755 "$INSTALL_DIR/lib/"*.sh

    cat > "$VPSSEC_SYSTEMD_DIR/vps-security-monitor.service" <<EOF
[Unit]
Description=vps-security rogue-port monitor
After=network-online.target ufw.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$INSTALL_DIR/lib/monitor.sh --scan
EOF

    cat > "$VPSSEC_SYSTEMD_DIR/vps-security-monitor.timer" <<EOF
[Unit]
Description=Run vps-security monitor every 30 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=30min
Unit=vps-security-monitor.service

[Install]
WantedBy=timers.target
EOF

    cat > "$VPSSEC_SYSTEMD_DIR/vps-security-maint.service" <<EOF
[Unit]
Description=vps-security maintenance (RAM cache + log cleanup)

[Service]
Type=oneshot
EnvironmentFile=-$VPSSEC_CONF_DIR/maintain.conf
ExecStart=$INSTALL_DIR/lib/maintain.sh --run
EOF

    cat > "$VPSSEC_SYSTEMD_DIR/vps-security-maint.timer" <<EOF
[Unit]
Description=Run vps-security maintenance every 2 days

[Timer]
OnBootSec=10min
RandomizedDelaySec=15min
OnUnitActiveSec=2d
Persistent=true
Unit=vps-security-maint.service

[Install]
WantedBy=timers.target
EOF

    cat > "$VPSSEC_SYSTEMD_DIR/vps-security-guard.service" <<EOF
[Unit]
Description=vps-security local guard API
After=network.target

[Service]
Type=simple
ExecStart=$INSTALL_DIR/lib/guard.sh --serve --port $guard_port
Restart=always
RestartSec=5
EOF

    $SYSTEMCTL daemon-reload
    $SYSTEMCTL enable --now vps-security-monitor.timer
    $SYSTEMCTL enable --now vps-security-maint.timer
    $SYSTEMCTL restart vps-security-guard.service
    ok "Monitor timer armed (every 30 min), maintenance timer armed (every 2 days), guard service started."
}

# ============================================================
# Status dashboard
# ============================================================

cmd_status() {
    need_root
    ensure_dirs
    ui_title "Dashboard — System Security Status"
    local allowed_n blocked_n
    allowed_n="$(port_count)"
    blocked_n="$(blocked_count)"

    # Firewall
    if ufw_active; then
        printf "  ${GREEN}●${RESET} Firewall        : active (ufw)\n"
    elif command -v ufw >/dev/null 2>&1; then
        printf "  ${YELLOW}●${RESET} Firewall        : installed but inactive\n"
    else
        printf "  ${RED}●${RESET} Firewall        : ufw not installed\n"
    fi

    # SSH
    local sp
    sp="$(ssh_port_in_config)"
    [ -z "$sp" ] && sp="22"
    printf "  ${CYAN}●${RESET} SSH port        : %s\n" "$sp"

    # Monitor
    if monitor_installed; then
        printf "  ${GREEN}●${RESET} Rogue monitor   : installed (every 30 min)\n"
    else
        printf "  ${YELLOW}●${RESET} Rogue monitor   : not installed\n"
    fi

    # Maintenance
    if [ -f "$VPSSEC_SYSTEMD_DIR/vps-security-maint.timer" ]; then
        printf "  ${GREEN}●${RESET} Maintenance     : installed (RAM cache + log cleanup, every 2 days)\n"
    else
        printf "  ${YELLOW}●${RESET} Maintenance     : not installed\n"
    fi

    # Iranian mirror & DNS
    if [ -f "$VPSSEC_CONF_DIR/mirror.conf" ] && grep -q '^MIRROR_NAME=..' "$VPSSEC_CONF_DIR/mirror.conf" 2>/dev/null; then
        local mn
        mn="$(grep '^MIRROR_NAME=' "$VPSSEC_CONF_DIR/mirror.conf" | cut -d= -f2)"
        printf "  ${GREEN}●${RESET} Git mirror      : %s\n" "$mn"
    else
        printf "  ${DIM}●${RESET} Git mirror      : direct github.com\n"
    fi

    # Summary
    printf "  ${CYAN}●${RESET} Allowed ports   : %s\n" "$allowed_n"
    if [ "$blocked_n" -gt 0 ]; then
        printf "  ${RED}●${RESET} Blocked ports   : %s\n" "$blocked_n"
    else
        printf "  ${GREEN}●${RESET} Blocked ports   : 0\n"
    fi
    if bash "$SCRIPT_DIR/lib/botshield.sh" --health 2>/dev/null; then
        printf "  ${GREEN}●${RESET} Bot shield      : active\n"
    else
        printf "  ${DIM}●${RESET} Bot shield      : off\n"
    fi
    if bash "$SCRIPT_DIR/lib/geoip.sh" --health 2>/dev/null; then
        local geo_ccs
        geo_ccs="$(grep '^GEO_COUNTRIES=' "$VPSSEC_CONF_DIR/geo.conf" 2>/dev/null | cut -d= -f2)"
        printf "  ${GREEN}●${RESET} GeoIP filter    : active (%s)\n" "${geo_ccs:-(no countries)}"
    else
        printf "  ${DIM}●${RESET} GeoIP filter    : off\n"
    fi

    echo
    ui_line
    echo
    if command -v ufw >/dev/null 2>&1; then
        ufw status verbose | sed 's/^/  /'
        echo
    fi
    "$SCRIPT_DIR/lib/monitor.sh" --status | tail -n +2 | sed 's/^/  /' || true
    echo
    echo "  Services:"
    $SYSTEMCTL is-active vps-security-monitor.timer >/dev/null 2>&1 \
        && printf "    ${GREEN}●${RESET} monitor timer : active\n" \
        || printf "    ${DIM}○${RESET} monitor timer : not active\n"
    $SYSTEMCTL is-active vps-security-guard.service >/dev/null 2>&1 \
        && printf "    ${GREEN}●${RESET} guard service : active\n" \
        || printf "    ${DIM}○${RESET} guard service : not active\n"
    echo
}

# ============================================================
# Ports — add / remove (with list)
# ============================================================

action_port_add() {
    ensure_dirs
    touch "$ALLOWED_PORTS_CONF"
    local p sp
    p="$(read_port "Port to open (e.g. 443)" "")"
    sp="$(ssh_port_in_config 2>/dev/null || echo 22)"
    if [ "$p" = "$sp" ]; then
        info "Port $p is the current SSH port — it is always open."
    fi
    if grep -qx "$p" "$ALLOWED_PORTS_CONF" 2>/dev/null; then
        info "Port $p is already in the allowed list."
        return 0
    fi
    echo "$p" >> "$ALLOWED_PORTS_CONF"
    if command -v ufw >/dev/null 2>&1; then
        ufw allow "$p"/tcp >/dev/null 2>&1
        ufw allow "$p"/udp >/dev/null 2>&1
    fi
    ok "Port $p is now open (allowed + ufw rule)."
}

action_port_remove() {
    ensure_dirs
    if [ "$(port_count)" -eq 0 ]; then
        warn "The allowed list is empty — nothing to remove."
        return 0
    fi
    ui_title "Allowed Ports — Remove One"
    local ports=() i n=0
    while IFS= read -r p; do ports+=("$p"); done < <(list_ports_raw)
    for i in "${!ports[@]}"; do
        printf "  %2d) port %s\n" $((i + 1)) "${ports[$i]}"
    done
    echo
    prompt "Number of the port to REMOVE (empty = cancel): "
    read -r idx
    [ -z "$idx" ] && { info "Cancelled."; return 0; }
    case "$idx" in
        ''|*[!0-9]*) warn "Invalid choice."; return 0 ;;
    esac
    [ "$idx" -lt 1 ] || [ "$idx" -gt "${#ports[@]}" ] && { warn "Invalid choice."; return 0; }
    local target="${ports[$((idx - 1))]}"

    local sp
    sp="$(ssh_port_in_config || echo 22)"
    if [ "$target" = "$sp" ]; then
        err "Port $target is the SSH port — refusing to remove it (you would lock yourself out)."
        return 0
    fi

    sed -i "/^${target}\$/d" "$ALLOWED_PORTS_CONF"
    if command -v ufw >/dev/null 2>&1; then
        ufw delete allow "$target"/tcp >/dev/null 2>&1
        ufw delete allow "$target"/udp >/dev/null 2>&1
    fi
    ok "Port $target removed from the allowed list and closed in ufw."
}

