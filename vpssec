# ============================================================
# Blocked ports + unblock
# ============================================================

action_blocked_view() {
    ensure_dirs
    ui_title "Blocked Ports"
    local n=0
    if [ -f "$BLOCK_LIST_FILE" ] && [ -s "$BLOCK_LIST_FILE" ]; then
        local now ts port remain
        now="$(date +%s)"
        while IFS='|' read -r ts port || [ -n "${ts:-}" ]; do
            [ -z "${ts:-}" ] && continue
            is_valid_port "$port" || continue
            n=$((n + 1))
            remain=$(( 3600 - (now - ts) ))
            [ "$remain" -lt 0 ] && remain=0
            printf "  %2d) port %-6s ${YELLOW}unblocks in %dm %02ds${RESET}\n" "$n" "$port" $((remain / 60)) $((remain % 60))
        done < "$BLOCK_LIST_FILE"
    fi
    [ "$n" -eq 0 ] && info "No ports are currently blocked. All clear ✓"
    return 0
}

action_unblock() {
    ensure_dirs
    ui_title "Unblock a Port"
    local ports=() ts port n=0
    if [ -f "$BLOCK_LIST_FILE" ] && [ -s "$BLOCK_LIST_FILE" ]; then
        while IFS='|' read -r ts port || [ -n "${ts:-}" ]; do
            [ -z "${ts:-}" ] && continue
            is_valid_port "$port" || continue
            ports+=("$port")
            n=$((n + 1))
            printf "  %2d) port %s\n" "$n" "$port"
        done < "$BLOCK_LIST_FILE"
    fi
    if [ "$n" -eq 0 ]; then
        info "No ports are currently blocked."
        return 0
    fi
    echo
    prompt "Number of the port to UNBLOCK (empty = cancel): "
    read -r idx
    [ -z "$idx" ] && { info "Cancelled."; return 0; }
    case "$idx" in
        ''|*[!0-9]*) warn "Invalid choice."; return 0 ;;
    esac
    [ "$idx" -lt 1 ] || [ "$idx" -gt "$n" ] && { warn "Invalid choice."; return 0; }
    local target="${ports[$((idx - 1))]}"
    "$SCRIPT_DIR/lib/monitor.sh" --unblock "$target"
}

