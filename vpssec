        reset)      need_root; bash "$SCRIPT_DIR/lib/mirror.sh" --reset ;;
        status)     bash "$SCRIPT_DIR/lib/mirror.sh" --status ;;
        *)          bash "$SCRIPT_DIR/lib/mirror.sh" --status ;;
    esac
}

action_geo_add() {
    ui_title "Add Allowed Countries"
    info "Enter country codes or full country names, comma-separated."
    info "Examples: IR, Germany, ایران, USA, Turkey — as many as you want."
    info "Spelling is forgiving (netherlands / holland / NL all work)."
    info "Not sure of a code?  See the lookup table: vpssec geo names"
    prompt "Countries (e.g. IR,DE or Iran,Germany): "
    read -r ccs
    [ -z "$ccs" ] && { info "Cancelled."; return 0; }
    bash "$SCRIPT_DIR/lib/geoip.sh" --add "$ccs"
}

action_geo_remove() {
    ui_title "Remove Allowed Countries"
    bash "$SCRIPT_DIR/lib/geoip.sh" --list
    info "Country codes or full names both work (e.g. TR, Turkey, ترکیه)."
    info "Not sure of a code?  See the lookup table: vpssec geo names"
    prompt "Countries to remove: "
    read -r ccs
    [ -z "$ccs" ] && { info "Cancelled."; return 0; }
    bash "$SCRIPT_DIR/lib/geoip.sh" --remove "$ccs"
}

action_geo_bypass() {
    ui_title "Bypass — Never Geo-block an IP"
    info "Your current public IP: $(curl -fsSL --max-time 8 https://api.ipify.org 2>/dev/null || echo unknown)"
    info "This IP will always be allowed, even from a blocked country."
    prompt "IP or CIDR to always allow (empty = cancel): "
    read -r ip
    [ -z "$ip" ] && { info "Cancelled."; return 0; }
    bash "$SCRIPT_DIR/lib/geoip.sh" --bypass add "$ip"
}

cmd_geo() {
    case "${1:-list}" in
        add)     need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --add "${2:-}" ;;
        remove)  need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --remove "${2:-}" ;;
        enable)  need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --enable ;;
        disable) need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --disable ;;
        refresh) need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --refresh ;;
        bypass)  need_root; bash "$SCRIPT_DIR/lib/geoip.sh" --bypass "${2:-add}" "${3:-}" ;;
        names)   bash "$SCRIPT_DIR/lib/geoip.sh" --names ;;
        list)    bash "$SCRIPT_DIR/lib/geoip.sh" --list ;;
        *)       bash "$SCRIPT_DIR/lib/geoip.sh" --list ;;
    esac
}

# ============================================================
# Dispatcher
# ============================================================

case "${1:-}" in
    "")        show_menu ;;
    install)   shift; cmd_install "$@" ;;
    status)    cmd_status ;;
    ports)     cmd_ports ;;
    port)      cmd_port ;;
    scan)      need_root; action_scan ;;
    blocked)   cmd_blocked ;;
    unblock)   shift; cmd_unblock "$@" ;;
    update)    cmd_update ;;
    logs)      shift; cmd_logs "$@" ;;
    uninstall) cmd_uninstall ;;
    shield)    shift; cmd_shield "$@" ;;        geo)     shift; cmd_geo "$@" ;;
    maint)     shift; cmd_maint "$@" ;;
    mirror)    shift; cmd_mirror "$@" ;;
    help|-h|--help) cmd_help ;;
    version|--version) echo "vpssec $VERSION" ;;
    *) die "Unknown command: $1 (try 'vpssec help')" ;;
esac
